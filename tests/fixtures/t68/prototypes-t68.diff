+/// Fork-only observation, nothing checked (#4892's second gap, A5): a dimension on a new Bore3, the
+/// hole undone, then a new Bore4 elsewhere: what the Bore3 dimension reads, and the features' ids.
+#[test]
+#[ignore = "an observation for the fork's report, not a check"]
+fn observe_a_dimension_after_its_holes_id_could_come_back() {
+    let (mut s, drawing, view, five) = plate_with_five();
+    let hole = |name: &str, at: [f64; 3], diameter: f64| json!({"position": at, "direction": [0, 0, -1], "diameter": diameter, "name": name, "type": "simple"});
+    let id_of = |s: &Session, name: &str| s.doc.features.iter().find(|f| f.name == name).map(|f| f.id);
+    closed_edit(&mut s, &drawing, "solid.hole", hole("Bore3", [80.0, 20.0, 20.0], 6.0));
+    let bore3 = id_of(&s, "Bore3");
+    let rim = json!({"body": "Plate", "index": workshop_plate_round_index(&s, "Plate", [80.0, 20.0, 20.0], 3.0)});
+    let on3 = run(&mut s, ADD, json!({"view": ids::encode(view), "kind": {"radial": {"edge": rim}}}));
+    observe(&mut s, "Bore3 drilled", std::slice::from_ref(&on3));
+    closed_edit(&mut s, &drawing, "edit.undo", json!({}));
+    observe(&mut s, "Bore3 undone", std::slice::from_ref(&on3));
+    closed_edit(&mut s, &drawing, "solid.hole", hole("Bore4", [80.0, 60.0, 20.0], 8.0));
+    eprintln!("T67_OBSERVE feature ids: Bore3 {bore3:?}, Bore4 {:?}", id_of(&s, "Bore4"));
+    observe(&mut s, "Bore4 drilled after the undo", std::slice::from_ref(&on3));
+    observe(&mut s, "the five then", &five);
+}
