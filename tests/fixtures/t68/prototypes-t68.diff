+/// What each of `added` reads now, printed for the fork's report.
+fn observe(s: &mut Session, label: &str, added: &[Value]) {
+    for (i, d) in added.iter().enumerate() {
+        let read = run(s, INSPECT, json!({"dimension": d["dimension"]}));
+        eprintln!("T67_OBSERVE {label} #{i}: status={} value={} last_good={} why={}", read["status"], read["value"], read["last_good"], read["why"]);
+    }
+}
